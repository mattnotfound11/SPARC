# Copy this file to .env.local and fill in both values from your Supabase project
# (Connect button, or Settings -> API Keys). Step-by-step: ../docs/supabase-setup.md
#
# With these set, drivers, slots and the gate log are kept in the shared database, with live
# updates between devices. Leave them empty and everything runs on demo data saved in each browser.
#
# The publishable key is meant to be public. Never put the secret key (sb_secret_...) here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The database is PUBLIC for now (anyone with the key can read and change everything), so /admin
# needs no login. After running supabase/lock-down.sql, set this to true to require an admin login.
NEXT_PUBLIC_REQUIRE_ADMIN_LOGIN=false
